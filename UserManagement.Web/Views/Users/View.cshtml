@model UserManagement.Web.Models.Users.UserViewModel

<h2>User Details</h2>

<dl>
    <dt>Id</dt>
    <dd>@Model.Id</dd>

    <dt>Forename</dt>
    <dd>@Model.Forename</dd>

    <dt>Surname</dt>
    <dd>@Model.Surname</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Date of Birth</dt>
    <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

    <dt>Account Active</dt>
    <dd>@(Model.IsActive ? "Yes" : "No")</dd>
</dl>

<h3>Activity Log</h3>
<ul>
@foreach (var log in Model.Logs)
{
    <li>@log.Action &mdash; @log.Timestamp.ToString("dd MMM yyyy HH:mm")</li>
}
</ul>

<a asp-controller="Users" asp-action="List" class="btn btn-default">Back to List</a>
