@model UserManagement.Web.Models.Users.UserViewModel

<h2>Delete User</h2>

<p>Are you sure you want to delete this user?</p>

<dl>
    <dt>Id</dt>
    <dd>@Model.Id</dd>

    <dt>Forename</dt>
    <dd>@Model.Forename</dd>

    <dt>Surname</dt>
    <dd>@Model.Surname</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Date of Birth</dt>
    <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

    <dt>Account Active</dt>
    <dd>@(Model.IsActive ? "Yes" : "No")</dd>
</dl>

<button type="button" id="confirmDelete" class="btn btn-danger" data-id="@Model.Id">Delete</button>
<a asp-controller="Users" asp-action="List" class="btn btn-default">Cancel</a>

<script>
    document.getElementById('confirmDelete').addEventListener('click', async function () {
        await fetch(`/users/delete/${this.dataset.id}`, { method: 'DELETE' });
        window.location.href = '/users';
    });
</script>
