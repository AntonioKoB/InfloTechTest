@model UserManagement.Web.Models.Logs.LogDetailViewModel

<h2>Log Detail</h2>

<dl>
    <dt>User</dt>
    <dd><a asp-controller="Users" asp-action="View" asp-route-id="@Model.UserId">@Model.UserId</a></dd>

    <dt>Action</dt>
    <dd>@Model.Action</dd>

    <dt>Timestamp</dt>
    <dd>@Model.Timestamp.ToString("dd MMM yyyy HH:mm")</dd>
</dl>

<h3>Changes</h3>
@if (Model.Changes.Count == 0)
{
    <p>No changes recorded for this action.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Old Value</th>
                    <th>New Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var change in Model.Changes)
                {
                    <tr>
                        <td>@change.PropertyName</td>
                        <td>@(change.OldValue ?? "—")</td>
                        <td>@(change.NewValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Logs" asp-action="List" class="btn btn-default">Back to Logs</a>
