@page "/logs"

<MudText Typo="Typo.h4" Class="mb-4">Logs</MudText>

@foreach (var log in _items)
{
    <LogRow @key="log.Id" Log="log" />
}

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-4">
    <MudButton id="prev-page-button" OnClick="PreviousPage" Disabled="@(_page <= 1)">Previous</MudButton>
    <div id="page-info">Page @_page of @_totalPages</div>
    <MudButton id="next-page-button" OnClick="NextPage" Disabled="@(_page >= _totalPages)">Next</MudButton>
</MudStack>
