@if (Visible)
{
    <div class="add-user-overlay">
        <MudPaper Class="add-user-panel pa-4" Elevation="4">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h5">Add New User</MudText>
                <MudIconButton id="close-button" Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
            </div>
            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <UserFormFields Model="_model" />
                <MudGrid Class="mt-2">
                    <MudItem xs="6">
                        <label class="field-label" for="input-password">Password</label>
                        <InputText id="input-password" type="password" @bind-Value="_model.Password" class="field-input" />
                    </MudItem>
                </MudGrid>
                @if (_emailError is not null)
                {
                    <MudText id="email-error" Color="Color.Error" Class="mt-2">@_emailError</MudText>
                }
                <MudCardActions Class="pl-0 mt-2">
                    <MudButton id="save-button" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                    <MudButton id="cancel-button" OnClick="Cancel" Variant="Variant.Text" Class="ml-2">Cancel</MudButton>
                </MudCardActions>
            </EditForm>
        </MudPaper>
    </div>
}
